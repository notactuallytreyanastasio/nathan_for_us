<div class="min-h-[calc(100vh-3rem)] flex items-start sm:items-center justify-center px-4 py-12">
  <div class="w-full max-w-md card p-8">
    <.header class="text-center mb-8">
      Create account
      <:subtitle>Turn any video into GIFs, frame by frame.</:subtitle>
    </.header>

    <.simple_form :let={f} for={@changeset} action={~p"/users/register"}>
      <.input field={f[:email]} type="email" label="Email" autocomplete="email" required />

      <div>
        <.input
          field={f[:username]}
          type="text"
          label="Username"
          autocomplete="username"
          required
        />
        <p class="mt-1 text-xs text-stone-500 font-mono">
          2&ndash;20 characters &mdash; letters, numbers, underscores
        </p>
      </div>

      <div>
        <.input
          field={f[:password]}
          type="password"
          label="Password"
          autocomplete="new-password"
          required
        />
        <p class="mt-1 text-xs text-stone-500 font-mono">At least 12 characters</p>
      </div>

      <:actions>
        <.button phx-disable-with="Creating account..." class="btn-primary w-full">
          Create account
        </.button>
      </:actions>
    </.simple_form>

    <p class="text-center text-sm text-stone-500 mt-6">
      Already have an account?
      <.link navigate={~p"/users/log_in"} class="text-brand-deep hover:text-brand">
        Log in
      </.link>
    </p>
  </div>
</div>
