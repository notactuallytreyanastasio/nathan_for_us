<div class="min-h-[calc(100vh-3rem)] flex items-start sm:items-center justify-center px-4 py-12">
  <div class="w-full max-w-md card p-8">
    <.header class="text-center mb-8">
      Reset password
      <:subtitle>We'll send a reset link to your inbox.</:subtitle>
    </.header>

    <.simple_form
      :let={f}
      for={@conn.params["user"]}
      as={:user}
      action={~p"/users/reset_password"}
    >
      <.input field={f[:email]} type="email" label="Email" autocomplete="email" required />
      <:actions>
        <.button phx-disable-with="Sending..." class="btn-primary w-full">
          Send reset link
        </.button>
      </:actions>
    </.simple_form>

    <p class="text-center text-sm text-stone-500 mt-6">
      <.link href={~p"/users/register"} class="text-brand-deep hover:text-brand">
        Create account
      </.link>
      <span class="text-stone-300 mx-1">|</span>
      <.link href={~p"/users/log_in"} class="text-brand-deep hover:text-brand">
        Log in
      </.link>
    </p>
  </div>
</div>
