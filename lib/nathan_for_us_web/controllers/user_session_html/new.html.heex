<div class="min-h-[calc(100vh-3rem)] flex items-start sm:items-center justify-center px-4 py-12">
  <div class="w-full max-w-md card p-8">
    <.header class="text-center mb-8">
      Log in
      <:subtitle>Back to the frames.</:subtitle>
    </.header>

    <.simple_form :let={f} for={@conn.params["user"]} as={:user} action={~p"/users/log_in"}>
      <.error :if={@error_message}>{@error_message}</.error>

      <.input field={f[:email]} type="email" label="Email" autocomplete="email" required />
      <.input
        field={f[:password]}
        type="password"
        label="Password"
        autocomplete="current-password"
        required
      />

      <div class="flex items-center justify-between">
        <.input field={f[:remember_me]} type="checkbox" label="Keep me logged in" />
        <.link
          href={~p"/users/reset_password"}
          class="font-mono text-sm text-brand-deep hover:text-brand"
        >
          Forgot password?
        </.link>
      </div>

      <:actions>
        <.button phx-disable-with="Logging in..." class="btn-primary w-full">
          Log in
        </.button>
      </:actions>
    </.simple_form>

    <p class="text-center text-sm text-stone-500 mt-6">
      Don't have an account?
      <.link navigate={~p"/users/register"} class="text-brand-deep hover:text-brand">
        Create one
      </.link>
    </p>
  </div>
</div>
