<div class="min-h-screen">
  <.page_header
    title="Admin Frame Browser"
    subtitle="Browse all frames in a video and create GIFs"
  />

  <div class="max-w-7xl mx-auto px-6 py-6">
    <.admin_nav active={:frames} />
    
<!-- Video Selection -->
    <div class="card p-6 mb-6">
      <h2 class="font-mono uppercase tracking-wider text-xs text-stone-500 mb-4">Select video</h2>

      <%= if @videos == [] do %>
        <div class="border-2 border-dashed border-stone-300 rounded-xl py-16 px-6 text-center">
          <span class="hero-film size-10 text-stone-300 mx-auto block"></span>
          <h3 class="mt-3 font-mono uppercase tracking-wider text-stone-700">No videos yet</h3>
          <p class="mt-1 text-sm text-stone-500">Upload a video to browse its frames.</p>
          <.link navigate={~p"/admin/upload"} class="btn-primary mt-4">Upload video</.link>
        </div>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for video <- @videos do %>
            <button
              type="button"
              class={[
                "text-left border rounded-xl p-4 transition",
                if(@selected_video && @selected_video.id == video.id,
                  do: "border-brand ring-1 ring-brand bg-brand-tint",
                  else: "border-stone-200 bg-white hover:border-stone-300 hover:shadow-md"
                )
              ]}
              phx-click="select_video"
              phx-value-video_id={video.id}
            >
              <div class="font-medium text-stone-900 mb-2">{video.title}</div>
              <div class="text-sm text-stone-600 font-mono space-y-1">
                <div>Duration: {format_duration(video.duration_ms)}</div>
                <div>FPS: {video.fps}</div>
                <div>Frames: {video.frame_count}</div>
                <div class="capitalize">Status: {video.status}</div>
              </div>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= if @selected_video do %>
      <!-- Frame Browser -->
      <div class="card p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
          <h2 class="font-mono uppercase tracking-wider text-xs text-stone-500">
            Frames for "{@selected_video.title}"
          </h2>
          
<!-- Selection Controls -->
          <%= if @frames != [] do %>
            <div class="flex items-center gap-2">
              <button
                type="button"
                phx-click="select_all_frames"
                class="btn-secondary px-3 py-1 text-xs"
              >
                Select all
              </button>
              <button
                type="button"
                phx-click="deselect_all_frames"
                class="btn-secondary px-3 py-1 text-xs"
              >
                Deselect all
              </button>
              <span class="text-sm text-stone-600 font-mono">
                {length(@selected_frame_indices)} selected
              </span>
            </div>
          <% end %>
        </div>
        
<!-- GIF Generation Section -->
        <%= if length(@selected_frame_indices) > 0 do %>
          <div
            class="bg-stone-100 border border-stone-200 rounded-xl p-4 mb-6"
            phx-hook="ClientGifGenerator"
            id="gif-generator"
          >
            <!-- FFmpeg Status -->
            <%= if @ffmpeg_status do %>
              <div class="mb-3 font-mono text-sm">
                <%= case @ffmpeg_status.status do %>
                  <% "loading_ffmpeg" -> %>
                    <div class="text-stone-600 flex items-center gap-2">
                      <span class="hero-arrow-path-mini size-4 animate-spin"></span>
                      {@ffmpeg_status.message}
                    </div>
                  <% "ffmpeg_ready" -> %>
                    <div class="text-emerald-700 flex items-center gap-2">
                      <span class="hero-check-circle-mini size-4"></span>
                      {@ffmpeg_status.message}
                    </div>
                  <% "generating" -> %>
                    <div class="text-stone-600 flex items-center gap-2">
                      <span class="hero-arrow-path-mini size-4 animate-spin"></span>
                      {@ffmpeg_status.message}
                    </div>
                  <% "ffmpeg_error" -> %>
                    <div class="text-red-600 flex items-center gap-2">
                      <span class="hero-exclamation-circle-mini size-4"></span>
                      {@ffmpeg_status.message}
                    </div>
                  <% _ -> %>
                    <div class="text-stone-600">{@ffmpeg_status.message}</div>
                <% end %>
              </div>
            <% end %>

            <div class="flex flex-wrap items-center gap-3">
              <%= if @gif_generation_status == :generating do %>
                <button type="button" disabled class="btn-primary">
                  <span class="hero-arrow-path-mini size-4 animate-spin"></span> Generating GIF...
                </button>
              <% else %>
                <!-- Client-side generation (primary) -->
                <button type="button" phx-click="generate_gif_client" class="btn-primary">
                  Create GIF (client-side)
                </button>
                
<!-- Server-side fallback -->
                <button type="button" phx-click="generate_gif_server" class="btn-secondary">
                  Server fallback
                </button>
              <% end %>

              <%= if @gif_generation_status == :completed and @generated_gif_data do %>
                <a
                  href={@client_download_url || "data:image/gif;base64,#{@generated_gif_data}"}
                  download={"framecut_#{@selected_video.id}_#{length(@selected_frame_indices)}frames.gif"}
                  class="btn-secondary"
                  title="Download generated GIF"
                >
                  <span class="hero-arrow-down-tray-mini size-4"></span> Download GIF
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
        
<!-- Generated GIF Preview -->
        <%= if @gif_generation_status == :completed and @generated_gif_data do %>
          <div class="mb-6 flex justify-center">
            <div class="w-full max-w-[600px]">
              <div class="checkerboard border border-stone-200 rounded-xl overflow-hidden p-4 mb-4 flex justify-center">
                <img
                  src={"data:image/gif;base64,#{@generated_gif_data}"}
                  alt="Generated GIF from selected frames"
                  class="max-w-full max-h-80 rounded"
                />
              </div>
              
<!-- Caption underneath GIF -->
              <div class="card p-3">
                <div class="font-mono uppercase tracking-wider text-xs text-stone-500 mb-2">
                  Dialogue
                </div>
                <div class="text-sm leading-relaxed font-mono text-stone-700 text-left">
                  {get_selected_frames_captions(@frames, @selected_frame_indices)}
                </div>
              </div>
            </div>
          </div>
        <% end %>
        
<!-- Live Caption Preview for Selected Frames -->
        <%= if length(@selected_frame_indices) > 0 and (@gif_generation_status != :completed or is_nil(@generated_gif_data)) do %>
          <div class="card p-4 mb-6">
            <div class="font-mono uppercase tracking-wider text-xs text-stone-500 mb-2">
              Selected frames dialogue
            </div>
            <div class="text-sm leading-relaxed font-mono text-stone-700 text-left">
              {get_selected_frames_captions(@frames, @selected_frame_indices)}
            </div>
            <div class="font-mono text-xs text-stone-500 mt-2">
              {length(@selected_frame_indices)} frames selected
            </div>
          </div>
        <% end %>
        
<!-- Frames Grid -->
        <%= if @frames == [] do %>
          <div class="border-2 border-dashed border-stone-300 rounded-xl py-16 px-6 text-center">
            <span class="hero-photo size-10 text-stone-300 mx-auto block"></span>
            <h3 class="mt-3 font-mono uppercase tracking-wider text-stone-700">No frames</h3>
            <p class="mt-1 text-sm text-stone-500">This video has no extracted frames yet.</p>
          </div>
        <% else %>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-2 mb-6">
            <%= for {frame, index} <- Enum.with_index(@frames) do %>
              <button
                type="button"
                class={[
                  "text-left rounded-lg overflow-hidden transition",
                  if(index in @selected_frame_indices,
                    do: "border border-brand ring-2 ring-brand",
                    else: "border border-stone-200 hover:border-stone-300 hover:shadow-md"
                  )
                ]}
                phx-click="toggle_frame_selection"
                phx-value-frame_index={index}
                title={
                  if(index in @selected_frame_indices,
                    do: "Click to remove from selection",
                    else: "Click to add to selection"
                  )
                }
              >
                
<!-- Frame Image -->
                <div class="aspect-video bg-stone-100 relative">
                  <img
                    loading="lazy"
                    src={~p"/frame/#{frame.id}"}
                    alt={"Frame ##{frame.frame_number}"}
                    class="w-full h-full object-cover"
                  />
                  
<!-- Frame Number -->
                  <div class="absolute bottom-1 right-1 bg-black/70 text-white px-1 py-0.5 rounded text-xs font-mono">
                    #{frame.frame_number}
                  </div>
                  
<!-- Selection Indicator -->
                  <%= if index in @selected_frame_indices do %>
                    <div class="absolute top-1 right-1 bg-brand text-white rounded-full w-5 h-5 flex items-center justify-center">
                      <span class="hero-check-mini size-3"></span>
                    </div>
                  <% end %>
                </div>
                
<!-- Frame Info -->
                <div class="p-1 bg-white">
                  <div class="text-xs text-stone-500 font-mono text-center">
                    {format_timestamp(frame.timestamp_ms)}
                  </div>
                </div>
              </button>
            <% end %>
          </div>
          
<!-- Pagination -->
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="text-sm text-stone-600 font-mono">
              Showing {(@current_page - 1) * @frames_per_page + 1}-{min(
                @current_page * @frames_per_page,
                @total_frames
              )} of {@total_frames} frames
            </div>

            <div class="flex items-center gap-2">
              <%= if @current_page > 1 do %>
                <button
                  type="button"
                  phx-click="change_page"
                  phx-value-page={@current_page - 1}
                  class="btn-secondary px-3 py-1 text-xs"
                >
                  Previous
                </button>
              <% end %>

              <%= for page <- page_range(@current_page, total_pages(@total_frames, @frames_per_page)) do %>
                <button
                  type="button"
                  phx-click="change_page"
                  phx-value-page={page}
                  class={[
                    "px-3 py-1 text-xs font-mono rounded-lg border transition-colors",
                    if(page == @current_page,
                      do: "border-brand bg-brand-tint text-brand-deep font-bold",
                      else: "border-stone-300 bg-white text-stone-700 hover:bg-stone-100"
                    )
                  ]}
                >
                  {page}
                </button>
              <% end %>

              <%= if @current_page < total_pages(@total_frames, @frames_per_page) do %>
                <button
                  type="button"
                  phx-click="change_page"
                  phx-value-page={@current_page + 1}
                  class="btn-secondary px-3 py-1 text-xs"
                >
                  Next
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
